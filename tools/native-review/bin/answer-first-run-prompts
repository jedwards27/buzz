#!/usr/bin/env bash
# Answer the one-time macOS privacy prompts a fresh VM shows the first time the
# process that launches a review touches the local network or the microphone.
# Left unanswered they freeze the reviewed app's web view or steal focus from it.
# Best effort: each prompt is triggered by a tiny child process (a Bonjour browse,
# a one-second audio capture) and answered through the same Accessibility-trusted
# driver the harness uses. The answers are remembered per launching process, so
# this only has to succeed once. Exits 0 when a prompt was answered or never
# appeared; nonzero only if the driver could not run.
#
#   Local Network -> Allow
#   Microphone    -> Don't Allow (a review never records audio)
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DRIVER="${BUZZ_NATIVE_REVIEW_DRIVER:-$SCRIPT_DIR/swift/.build/release/buzz-native-driver}"
if [[ ! -x "$DRIVER" ]]; then
  swift build -c release --package-path "$SCRIPT_DIR/swift" >/dev/null
fi

# answer LABEL BUTTON HINT COMMAND...
answer() {
  local label="$1" button="$2" hint="$3"
  shift 3
  "$@" >/dev/null 2>&1 &
  local trigger=$!
  local pressed=0
  for _ in $(seq 1 20); do
    if "$DRIVER" press-system-alert-button --button "$button" --contains "$hint" | grep -Eq '"pressed" ?: ?true'; then
      pressed=1
      break
    fi
    sleep 0.5
  done
  kill "$trigger" 2>/dev/null || true
  wait "$trigger" 2>/dev/null || true
  if ((pressed)); then
    echo "[answer-first-run-prompts] $label: pressed $button"
  else
    echo "[answer-first-run-prompts] $label: no prompt appeared (already answered, or not needed)"
  fi
}

answer "Local Network" "Allow" "local network" dns-sd -B _services._dns-sd._udp local.
if command -v ffmpeg >/dev/null 2>&1; then
  answer "Microphone" "Don't Allow" "microphone" \
    ffmpeg -hide_banner -loglevel error -f avfoundation -i ":0" -t 1 -f null -
else
  echo "[answer-first-run-prompts] Microphone: ffmpeg not installed, skipping"
fi
