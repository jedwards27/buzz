#!/usr/bin/env bash
# Answer the one-time macOS privacy prompts a fresh VM shows the first time the
# process that launches a review touches the local network or the microphone.
# Left unanswered they freeze the reviewed app's web view or steal focus from it.
# Best effort: each prompt is triggered by a tiny child process (a Bonjour browse,
# a one-second audio capture) and answered through the same Accessibility-trusted
# driver the harness uses. The answers are remembered per launching process, so
# this only has to succeed once. Exits 0 when a prompt was answered or never
# appeared; nonzero only if the driver could not run.
#
# The driver presses a button only when it can positively identify the window as
# the system's own privacy alert (owned by the system prompt agent, a system
# dialog) that names a process of this run: this script's ancestry, the reviewed
# app, or the trigger it launched here. Anything else is left alone and logged.
#
#   Local Network -> Allow
#   Microphone    -> Don't Allow (a review never records audio)
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DRIVER="${BUZZ_NATIVE_REVIEW_DRIVER:-$SCRIPT_DIR/swift/.build/release/buzz-native-driver}"
if [[ ! -x "$DRIVER" ]]; then
  swift build -c release --package-path "$SCRIPT_DIR/swift" >/dev/null
fi

# Stop a trigger child. A process blocked on an unanswered privacy prompt can ignore
# SIGTERM, so escalate rather than wait on it forever.
stop_trigger() {
  kill "$1" 2>/dev/null || true
  for _ in 1 2 3 4 5 6; do kill -0 "$1" 2>/dev/null || break; sleep 0.5; done
  kill -9 "$1" 2>/dev/null || true
  wait "$1" 2>/dev/null || true
}

# answer LABEL TRIGGER_NAME COMMAND...
# Starts the trigger, then answers whatever prompt the driver can positively identify
# as this run's own. The log line carries the prompt text that was actually answered,
# which may be an earlier trigger's prompt that was still on screen.
answer() {
  local label="$1" trigger_name="$2"
  shift 2
  "$@" >/dev/null 2>&1 &
  local trigger=$!
  local pressed=0 skipped="" failed=""
  for _ in $(seq 1 20); do
    if ! reply="$("$DRIVER" answer-privacy-prompt --expect "$trigger_name" 2>&1)"; then
      failed="$reply"
    elif grep -Eq '"answered" ?: ?true' <<<"$reply"; then
      pressed=1
      echo "[answer-first-run-prompts] while triggering $label, answered: $reply"
      break
    elif grep -Eq '"skipped" ?: ?\[ ?"' <<<"$reply"; then
      skipped="$reply"
    fi
    sleep 0.5
  done
  stop_trigger "$trigger"
  if ((pressed)); then
    :
  elif [[ -n "$skipped" ]]; then
    echo "[answer-first-run-prompts] $label: a window was left alone because it could not be identified as this run's prompt: $skipped"
  elif [[ -n "$failed" ]]; then
    echo "[answer-first-run-prompts] $label: the driver could not run: $failed"
  else
    echo "[answer-first-run-prompts] $label: no prompt appeared (already answered, or not needed)"
  fi
}

answer "Local Network" dns-sd dns-sd -B _services._dns-sd._udp local.
if command -v ffmpeg >/dev/null 2>&1; then
  answer "Microphone" ffmpeg \
    ffmpeg -hide_banner -loglevel error -f avfoundation -i ":0" -t 1 -f null -
else
  echo "[answer-first-run-prompts] Microphone: ffmpeg not installed, skipping"
fi
