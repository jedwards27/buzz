#!/usr/bin/env bash
# Answer the one-time macOS "Local Network" prompt ("Allow <agent> to find devices
# on local networks?") that a fresh VM shows the first time any app on it touches
# the network, and which otherwise covers the reviewed window. Best effort:
# triggers the prompt with a Bonjour browse, then presses Allow through the same
# Accessibility-trusted native driver the harness uses. Exits 0 if the prompt was
# answered or never appeared; nonzero only if the driver could not run.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
DRIVER="${BUZZ_NATIVE_REVIEW_DRIVER:-$SCRIPT_DIR/swift/.build/release/buzz-native-driver}"
if [[ ! -x "$DRIVER" ]]; then
  swift build -c release --package-path "$SCRIPT_DIR/swift" >/dev/null
fi

dns-sd -B _services._dns-sd._udp local. >/dev/null 2>&1 &
browse=$!
trap 'kill "$browse" 2>/dev/null || true' EXIT
for _ in $(seq 1 20); do
  if "$DRIVER" press-system-alert-button --button Allow --contains "local network" | grep -Eq '"pressed" ?: ?true'; then
    echo "[allow-local-network-prompt] pressed Allow"
    exit 0
  fi
  sleep 0.5
done
echo "[allow-local-network-prompt] no Local Network prompt appeared (already answered, or not needed)"
